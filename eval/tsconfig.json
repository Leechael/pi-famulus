{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@earendil-works/pi-ai": [
        "./node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-ai/dist/compat.d.ts"
      ]
    }
  },
  "include": [
    "lib/**/*.ts",
    "harness/**/*.ts",
    "e2e/**/*.ts",
    "ablation/**/*.ts",
    "replay/**/*.ts"
  ]
}
