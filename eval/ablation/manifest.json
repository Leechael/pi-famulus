  "notAblatableExternally": [
    {
      "what": "Everything inside subagent child sessions: CHILD_BEHAVIOR_GUIDELINES (segment child.guidelines), contact_supervisor description, child bash description/errors, child-side agent_message description",
      "why": "By design, children load no extensions or global resources (isolated DefaultResourceLoader, noExtensions/noSkills), so no external hook runs in them. Ablating these would need a seam in the extension."
    },
    {
      "what": "Wake delivery mechanics: idle -> triggerTurn vs busy -> steer routing, 200ms task-exit coalescing, dedupe",
      "why": "pi.sendMessage has no interception hook; the ablation harness can only rewrite or drop message content, not suppress the triggered turn."
    }
  ]
