exports[`model-visible prompt surface > tool result instructions 1`] = `
{
  "background": "Command "./build.sh" moved to background (task_id: sh_00000001). Output: /tmp/out/sh_00000001.output.
You will be notified when it completes, even if other commands are still running. Do not poll or sleep: reply to the user now with no tool call, and continue from the <pi-famulus-wake kind="task"> when it arrives.",
  "monitorStarted": "You will get a <pi-famulus-wake kind="monitor"> for each event, and a notice when it exits or times out. Do not poll it (task_list, task_output, or reading what it watches) or sleep. After starting or re-arming a monitor, or handling a monitor event, if no work remains, end your turn with a reply and no tool call; simply wait for the next notification. Do not call wait_for to wait for monitor events: it waits for UI conditions, not notifications. Do not invent a stateId or make a failing tool call to yield.",
}
`;

exports[`model-visible prompt surface > wakes 1`] = `
{
  "changed": "System wake — not a new user message. Handle this <pi-famulus-wake> before other work.

<pi-famulus-wake kind="subagent-done" run-id="run_1" status="completed" duration-ms="9000" status-now="running" as-of="2026-10-07T12:00:00Z">
  <summary>1/1 subagents completed in 9000ms</summary>
  <changed-since-as-of>a (ch_1): completed → running. The run is active again; another subagent-done arrives when it finishes.</changed-since-as-of>
  <child id="ch_1" name="a" status="running" status-as-of="completed">
    <prompt>p</prompt>
    <result>r</result>
  </child>
</pi-famulus-wake>",
  "done": "System wake — not a new user message. Handle this <pi-famulus-wake> before other work.

<pi-famulus-wake kind="subagent-done" run-id="run_1" status="completed" duration-ms="9000">
  <summary>1/1 subagents completed in 9000ms</summary>
  <child id="ch_1" name="a" status="completed">
    <prompt>p</prompt>
    <result>r</result>
  </child>
</pi-famulus-wake>",
  "handover": "System wake — not a new user message. Handle this <pi-famulus-wake> before other work.

<pi-famulus-wake kind="subagent-handover" run-id="run_1" child-id="ch_1" name="a" status="completed">
  <still-running>
    <item id="ch_2">b</item>
  </still-running>
  <summary>a completed; 1 still running</summary>
  <prompt>p</prompt>
  <result>r</result>
</pi-famulus-wake>",
  "leadIn": "System wake — not a new user message. Handle this <pi-famulus-wake> before other work.",
  "monitor": "System wake — not a new user message. Handle this <pi-famulus-wake> before other work.

<pi-famulus-wake kind="monitor" id="mon_1" description="READY in service.log">
  <event>READY token=X
</event>
</pi-famulus-wake>",
  "overrun": "System wake — not a new user message. Handle this <pi-famulus-wake> before other work.

<pi-famulus-wake kind="subagent-overrun" run-id="run_1" child-id="ch_1" name="a" elapsed-ms="60000" budget-ms="60000" reminder="1">
  <summary>a has run 1m in this turn, past its 1m budget, and is still running; it is waiting on a shell command that has run 55s.</summary>
  <last-activity ago-ms="50000">assistant: tool bash</last-activity>
  <shell task-id="sh_1" elapsed-ms="55000" output-bytes="10" output-idle-ms="50000" growing="no">
    <command>./x.sh</command>
