exports[`model-visible prompt surface > tool result instructions 1`] = `
{
  "background": "Command "./build.sh" moved to background (task_id: sh_00000001). Output: /tmp/out/sh_00000001.output.
You will be notified when it completes, even if other commands are still running. Do not poll or sleep: reply to the user now with no tool call, and continue from the <pi-famulus-wake kind="task"> when it arrives.",
  "monitorStarted": "You will get <pi-famulus-wake kind="monitor"> notifications for admitted output and a notice when it exits or times out. Repeated lines may be suppressed and previews may be truncated; original output remains available through task_output byte ranges while the task log is retained. Read details only when needed; do not repeatedly poll task_list, task_output, or the watched source, and do not sleep to wait. After starting or re-arming a monitor, or handling a monitor event, if no immediate work remains, end your turn with no tool call; simply wait for the next notification. Handling an event does not require a user-visible reply. Do not repeat unchanged/intermediate status or narrate your decision to stay quiet; notify the user when their requested condition is met, their input is needed, or a failure prevents further progress. Read original output with task_output only when details are needed (including paging a truncated preview), never to poll or wait. Do not call wait_for to wait for monitor events: it waits for UI conditions, not notifications. Do not invent a stateId or make a failing tool call to yield.",
}
`;

exports[`model-visible prompt surface > wakes 1`] = `
{
  "changed": "System wake — not a new user message. Handle this <pi-famulus-wake> before other work.

<pi-famulus-wake kind="subagent-done" run-id="run_1" status="completed" duration-ms="9000" status-now="running" as-of="2026-10-07T12:00:00Z">
