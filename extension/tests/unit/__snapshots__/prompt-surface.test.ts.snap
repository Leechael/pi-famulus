                "description": "Display name (default: agent name + ordinal)",
                "type": "string",
              },
              "prompt": {
                "description": "Task prompt for this subagent",
                "type": "string",
              },
              "work_kind": {
                "anyOf": [
                  {
                    "const": "test-suite",
                    "type": "string",
                  },
                  {
                    "const": "test",
                    "type": "string",
                  },
                  {
                    "const": "build",
                    "type": "string",
                  },
                  {
                    "const": "lint/type",
                    "type": "string",
                  },
                  {
                    "const": "other",
                    "type": "string",
                  },
                  {
                    "const": "git",
                    "type": "string",
                  },
                  {
