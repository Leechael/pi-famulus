          "description": "Default exact. Explicit ignore-timestamps mode ignores only supported leading/trailing ISO timestamps when comparing Rust-framed lines; original output is unchanged. Numbers, paths, resource identities, and interior timestamps remain significant.",
        },
        "persistent": {
          "description": "Keep the monitor alive until the session ends (no timeout). Default false.",
          "type": "boolean",
        },
        "timeout_ms": {
          "description": "Stop the monitor after this many milliseconds (default 300000, min 1000, max 3600000)",
          "type": "number",
