        },
        "delivery": {
          "anyOf": [
            {
              "const": "steer",
              "type": "string",
            },
            {
              "const": "queue",
              "type": "string",
            },
          ],
          "description": ""steer" (default) delivers to a running child after its current tool call/turn finishes; "queue" delivers after its current turn. Sending to a finished child is an error — resume with subagent({action:"resume"}).",
        },
        "message": {
          "description": "Message text.",
          "type": "string",
        },
        "to": {
          "description": "Target child_id or name ("send"/"reply"). For "broadcast" from the parent session: run_id. Child sessions broadcast to their own run and must omit this.",
          "type": "string",
        },
      },
      "required": [
