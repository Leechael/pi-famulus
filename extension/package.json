{
  "name": "pi-famulus",
  "version": "0.1.7",
  "description": "Done means done: subagents and long-running background bash for Pi. One daemon owns every shell it starts and wakes the agent when work finishes. No polling.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "subagent",
    "subagents",
    "background",
    "background-tasks",
    "bash",
    "daemon",
    "multi-agent",
    "monitor",
    "agent-orchestration"
  ],
  "author": "Leechael Yim",
  "homepage": "https://github.com/Leechael/pi-famulus",
  "bugs": {
    "url": "https://github.com/Leechael/pi-famulus/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Leechael/pi-famulus",
    "directory": "extension"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "bin": {
    "pi-famulus": "./bin/pi-famulus.js"
  },
  "optionalDependencies": {
    "pi-famulus-linux-x64": "0.1.7",
    "pi-famulus-linux-arm64": "0.1.7",
    "pi-famulus-darwin-x64": "0.1.7",
    "pi-famulus-darwin-arm64": "0.1.7",
    "pi-famulus-win-x64": "0.1.7",
    "pi-famulus-win-arm64": "0.1.7"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "deps": "nub install --frozen-lockfile --node-linker hoisted",
    "prompts": "node scripts/build-prompts.ts",
    "test": "vitest run",
    "test:compat": "vitest run tests/unit/impl-child-resource-isolation.test.ts tests/unit/impl-child-tools.test.ts tests/unit/impl-child-guidelines.test.ts tests/unit/impl-subagent-lifecycle.test.ts tests/unit/impl-steering-drain.test.ts tests/unit/impl-model-spec.test.ts tests/unit/impl-eval-fixes.test.ts tests/integration/behavior-guidelines.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "typebox": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
