{
  "name": "pi-famulus",
  "version": "0.1.2",
  "description": "Subagents and long-running bash for pi. Shell commands and monitors run under a daemon that stops everything they started if it exits or crashes, and results report back when done: no polling.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "subagent",
    "subagents",
    "background-tasks",
    "bash",
    "daemon",
    "multi-agent"
  ],
  "author": "Leechael Yim",
  "homepage": "https://github.com/Leechael/pi-famulus",
  "bugs": {"url": "https://github.com/Leechael/pi-famulus/issues"},
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leechael/pi-famulus",
    "directory": "extension"
  },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "os": ["linux", "darwin", "win32"],
  "cpu": ["x64", "arm64"],
  "files": ["src", "bin", "README.md"],
  "bin": { "pi-famulus": "./bin/pi-famulus.js" },
  "optionalDependencies": {
    "pi-famulus-linux-x64": "0.1.2",
    "pi-famulus-linux-arm64": "0.1.2",
    "pi-famulus-darwin-x64": "0.1.2",
    "pi-famulus-darwin-arm64": "0.1.2",
    "pi-famulus-win-x64": "0.1.2"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "deps": "nub install --frozen-lockfile --node-linker hoisted",
    "prompts": "node scripts/build-prompts.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "typebox": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
